# Copy to .env and fill in as needed. Every value here is optional except PORT —
# the chatbot works fully offline (rule-based + local knowledge base) with no
# keys set at all.

PORT=5050

# --- Optional: connect to the SAME MongoDB the main site uses, so the bot can
# answer live questions like "what fertilizers do you have" or "tell me about
# PM-KISAN" straight from your Products / Schemes / CropTips collections.
# Leave blank to run the bot in knowledge-base-only mode.
MONGO_URI=mongodb+srv://miyasahebsevakendra:krushisevakendra123@cluster0.ux0vrzw.mongodb.net/?appName=Cluster0

# --- Optional: let an LLM phrase fuller, more natural answers for general
# agriculture questions the local knowledge base doesn't cover well. The bot's
# topic guard still blocks non-agriculture questions BEFORE they ever reach the
# LLM, and only ONE provider is used (OpenAI checked first, then Anthropic).
# Leave both blank to stay in knowledge-base-only mode (fully offline, free).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# Comma-separated list of origins allowed to call this API (set to your site's
# origin in production). * for local development/testing.
CLIENT_ORIGIN=*
